# Always keep this as a plain "file:" value, in every environment,
# including production. Prisma validates this against the "sqlite"
# provider's own protocol at client runtime regardless of whether an
# adapter is used for the real connection — a non-"file:" value here
# crashes every query with "the URL must start with the protocol file:".
DATABASE_URL="file:./dev.db"

# Deploying to Vercel (or any serverless host with no persistent disk)? A
# local SQLite file won't survive between requests there. Create a free
# database at https://turso.tech, then set BOTH of these — the app detects
# TURSO_DATABASE_URL and automatically routes queries through Turso's
# driver instead of the file above:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# One-time setup: apply prisma/turso-init.sql to your Turso database once
# (paste it into the Turso dashboard's SQL console, or `turso db shell
# your-db < prisma/turso-init.sql`) — there's no automated way to run
# Prisma's own migration commands against a remote libsql:// URL without
# extra CLI configuration, so this file is the schema instead.

# Optional: enables real AI vision identification + listing generation via
# the Anthropic API. Without this key, /api/analyze and /api/assistant fall
# back to deterministic mock data so the full flow still works end-to-end.
ANTHROPIC_API_KEY=

# Required: secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Set to "true" once this app is deployed behind HTTPS (Vercel, a TLS-
# terminating reverse proxy, etc.) to mark the session cookie Secure.
# Leave unset for local/plain-HTTP self-hosting, or login will silently fail.
COOKIE_SECURE=

# Optional: enables automated emails (welcome, password reset, item sold,
# buyer message alerts) sent via your own Gmail account over SMTP — no
# third-party email service. GMAIL_APP_PASSWORD is NOT your Gmail password;
# generate a dedicated one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first).
# Without these set, emails are just logged to the server console instead
# of sent, so the app still works end-to-end without them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required if GMAIL_USER is set: base URL used to build the password-reset
# link in the reset email (e.g. https://your-app.vercel.app). Defaults to
# http://localhost:3000 for local dev.
APP_URL=
