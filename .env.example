# Postgres connection string - from Vercel Postgres, Neon, Supabase, etc.
# If your provider gives you a pooled connection (hostname often contains
# "-pooler" or "pgbouncer"), put that here for normal app queries.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A direct (non-pooled) connection to the SAME database, used only for
# running migrations (pooled connections can't take the schema locks
# migrations need). If your provider only gives you one connection string
# (no pooler), set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# The public URL of your deployed site (used to build password-reset links).
# Use http://localhost:3000 for local dev.
APP_URL="http://localhost:3000"

# Your Gmail address and an "App Password" (NOT your normal Gmail password).
# See README.md for how to generate one.
GMAIL_USER="you@yourbusiness.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
EMAIL_FROM_NAME="ResellAI"
