generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  inventoryItems         InventoryItem[]
  activityLogs           ActivityLog[]
  marketplaceConnections MarketplaceConnection[]
  chatMessages           ChatMessage[]
  buyerMessages          BuyerMessage[]
}

// Local-first inventory record. Mirrors supabase/schema.sql for the
// optional Postgres cloud-sync backend described in the product spec.
model InventoryItem {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku      String
  barcode  String?

  // Identification
  name     String
  brand    String?
  model    String?
  category String?
  color    String?
  size     String?
  material String?
  year     String?
  rarity   String?

  // Condition grading
  condition       String?
  conditionScore  Int?
  conditionReason String?
  aiConfidence    Int?

  // Authenticity / counterfeit risk
  authenticityRisk  String?
  authenticityNotes String?

  // Photos: JSON array of data URLs / storage paths, ranked best-first
  photos String @default("[]")

  // Acquisition
  purchaseDate DateTime?
  purchasePrice Float?
  shippingCostEstimate Float?
  packagingCost Float?
  location      String?

  // Pipeline status: purchased, needs_photos, ai_processing, draft, listed, sold, shipped, archived
  status String @default("purchased")

  // Pricing engine output
  msrp            Float?
  currentRetail   Float?
  avgSoldPrice    Float?
  lowestActive    Float?
  highestSoldPrice Float?
  fastPrice   Float?
  normalPrice Float?
  maxPrice    Float?
  listingPrice Float?
  pricingStrategy String @default("normal")

  // Listing generator output
  title          String?
  description    String?
  keywords       String  @default("[]")
  itemSpecifics  String  @default("{}")
  marketplaces   String  @default("[]")
  marketplaceStatus String @default("{}")
  marketplaceListings String @default("{}")

  // Sale tracking
  salePrice   Float?
  platformFees Float?
  soldDate    DateTime?
  daysListed  Int?
  profit      Float?
  roi         Float?
  profitMargin Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerMessages BuyerMessage[]

  @@unique([userId, sku])
  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, brand])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String   @default("info")
  itemId    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model MarketplaceConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  connected Boolean  @default(false)
  feePercent Float   @default(0)
  // Real credentials would be stored encrypted (e.g. via a KMS-backed vault)
  // and referenced here, never stored in plaintext.
  credentialsRef String?
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Buyer inquiries/offers per listing, with AI-drafted reply support.
model BuyerMessage {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  marketplace String
  buyerName   String
  body        String
  kind        String  @default("question") // question, offer, complaint
  offerAmount Float?
  status      String  @default("open") // open, replied, resolved
  reply       String?
  createdAt   DateTime @default(now())

  @@index([userId, status])
}
