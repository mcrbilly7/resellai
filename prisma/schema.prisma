generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  isAdmin            Boolean   @default(false)
  promoOptIn         Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())

  resetTokens  PasswordResetToken[]

  // Workers this user (as an account owner) has added to their account.
  ownedMemberships  Membership[] @relation("OwnerMemberships")
  // Accounts this user works for, as a worker.
  workerMemberships Membership[] @relation("WorkerMemberships")

  // Inventory items this user owns (their own account's data).
  items Item[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// A worker's access to an account owner's data. Looked up by email so an
// owner can add someone before that person has even signed up yet - workerId
// gets filled in automatically the moment that email creates an account.
model Membership {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("OwnerMemberships", fields: [ownerId], references: [id], onDelete: Cascade)

  workerEmail String
  workerId    String?
  worker      User?   @relation("WorkerMemberships", fields: [workerId], references: [id], onDelete: Cascade)

  // VIEWER | BUYER | SELLER | INVENTORY | CUSTOM - a label for the preset
  // that was last applied; the boolean flags below are what's actually
  // enforced, so a role can always be fine-tuned per worker.
  role String @default("VIEWER")

  canViewInventory Boolean @default(true)
  canEditInventory Boolean @default(false)
  canBuy           Boolean @default(false)
  canSell          Boolean @default(false)
  canViewEarnings  Boolean @default(false)

  // INVITED (email doesn't have an account yet) | ACTIVE | BLOCKED
  status String @default("INVITED")

  createdAt DateTime @default(now())

  @@unique([ownerId, workerEmail])
}

// Shared inventory. Always belongs to one account owner; workers read/write
// it through that owner's account according to their Membership permissions.
model Item {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String?
  status      String  @default("Draft")
  location    String?
  quantity     Int @default(1)
  quantitySold Int @default(0)

  purchasePrice Float?
  salePrice     Float?
  estValue      Float?

  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
